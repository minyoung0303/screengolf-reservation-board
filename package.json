{
  "name": "yeyakbo",
  "version": "1.0.3",
  "description": "타석 예약 관리 프로그램 (직원용)",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "ANBambi (Minyoung Lee)",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-node.mjs && vite build",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "docs": "electron scripts/md-to-pdf.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "shots": "electron scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "marked": "18.0.10",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
